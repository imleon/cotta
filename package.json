{
  "name": "cotta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "cd web && npm install",
    "dev": "tsx watch runtime/server/index.ts",
    "dev:web": "cd web && npm run dev",
    "build": "tsc -p tsconfig.json",
    "build:web": "cd web && npm run build",
    "build:all": "npm run build && npm run build:web",
    "start": "node dist/runtime/server/index.js",
    "test:cli": "echo \"test:cli removed (legacy agent runner)\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.117",
    "@hono/node-server": "^1.14.0",
    "@hono/node-ws": "^1.1.0",
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "dotenv": "^16.4.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
